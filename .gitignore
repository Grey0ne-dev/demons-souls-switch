# Track only the port sources, diagnostics, and selected development evidence.
/*
!/.gitignore
!/README.md
!/THIRD_PARTY_NOTICES.md
!/licenses/
!/switch-port/
!/switch-probe/
!/tools/
!/analysis/

# Local builds contain generated game translations and must stay local.
build*/
__pycache__/
*.py[cod]
*.o
*.a
*.so
*.elf
*.ELF
*.nro
*.nsp
*.xci
*.nca
*.bin
*.BIN
*.prx
*.zip
*.7z
*.iso
*.keys
.env
local.env
sdcard/
generated/
source-snapshot/

/analysis/*
!/analysis/*.md
!/analysis/source-preparation.patch
!/analysis/device-*/
/analysis/device-*/*
!/analysis/device-*/*.py
!/analysis/device-*/expected-device-trace.json
!/analysis/device-*/entry-provenance.json
!/analysis/device-*/device-result.json
!/analysis/device-*/build-verification.json
!/analysis/device-*/postrun-verification.json
!/analysis/device-*/*-audit.json
